{
  "name": "croff-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CROFF — an expressive utility-first CSS framework.",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b packages",
    "build:docs": "pnpm --filter @croff/docs build",
    "build:examples": "pnpm --filter \"./examples/*\" build",
    "build:all": "pnpm build && pnpm build:examples && pnpm build:docs",
    "typecheck": "tsc -b packages && tsc -p tsconfig.tests.json && pnpm --filter @croff/docs typecheck && pnpm --filter \"./examples/*\" --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "node scripts/bench.mjs",
    "docs:dev": "pnpm --filter @croff/docs dev",
    "changeset": "changeset",
    "clean": "node scripts/clean.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "browsers:install": "node scripts/install-browsers.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@croff/core": "workspace:*",
    "@croff/postcss": "workspace:*",
    "@croff/vite": "workspace:*",
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.14.0",
    "playwright": "~1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
