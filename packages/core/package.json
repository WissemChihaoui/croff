{
  "name": "@croffcss/core",
  "version": "0.1.1",
  "description": "The public CROFF API: configuration, engine and project orchestration.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WissemChihaoui/croff.git",
    "directory": "packages/core"
  },
  "homepage": "https://croff.wisecode.tn",
  "bugs": "https://github.com/WissemChihaoui/croff/issues",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@croffcss/parser": "workspace:*",
    "@croffcss/theme": "workspace:*",
    "@croffcss/registry": "workspace:*",
    "@croffcss/compiler": "workspace:*",
    "@croffcss/scanner": "workspace:*",
    "@croffcss/plugin-api": "workspace:*",
    "jiti": "^2.7.0"
  },
  "keywords": [
    "css",
    "croff",
    "utility-first",
    "framework",
    "design-tokens"
  ]
}
