{
  "name": "@croff/core",
  "version": "0.1.0",
  "description": "The public CROFF API: configuration, engine and project orchestration.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@croff/parser": "workspace:*",
    "@croff/theme": "workspace:*",
    "@croff/registry": "workspace:*",
    "@croff/compiler": "workspace:*",
    "@croff/scanner": "workspace:*",
    "@croff/plugin-api": "workspace:*",
    "jiti": "^2.7.0"
  },
  "keywords": [
    "css",
    "croff",
    "utility-first",
    "framework",
    "design-tokens"
  ]
}
