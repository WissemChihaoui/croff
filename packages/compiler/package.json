{
  "name": "@croff/compiler",
  "version": "0.1.0",
  "description": "Compiles CROFF expressions into deterministic CSS.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@croff/parser": "workspace:*",
    "@croff/theme": "workspace:*",
    "@croff/registry": "workspace:*"
  },
  "keywords": [
    "css",
    "croff",
    "compiler"
  ]
}
