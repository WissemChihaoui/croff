// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`snapshots > matches the reference stylesheet 1`] = `
":root {
  --croff-color-brand: #c8fd12;
  --croff-color-brand-dark: #a4d30b;
  --croff-spacing-4: 1rem;
  --croff-spacing-6: 1.5rem;
  --croff-radius-xl: 1rem;
}

.display\\(grid\\) {
  display: grid;
}

.flex\\(row\\) {
  display: flex;
  flex-direction: row;
}

.align\\(center\\) {
  align-items: center;
}

.justify\\(between\\) {
  justify-content: space-between;
}

.columns\\(3\\) {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.gap\\(4\\) {
  gap: var(--croff-spacing-4);
}

.width\\(full\\) {
  width: 100%;
}

.width\\[320px\\] {
  width: 320px;
}

.height\\[calc\\(100vh-80px\\)\\] {
  height: calc(100vh - 80px);
}

.padding\\(6\\) {
  padding: var(--croff-spacing-6);
}

.bg\\(brand\\) {
  background-color: var(--croff-color-brand);
}

.bg\\[\\#121212\\] {
  background: #121212;
}

.radius\\(xl\\) {
  border-radius: var(--croff-radius-xl);
}

.group:hover .group-hover\\:text-color\\(brand\\) {
  color: var(--croff-color-brand);
}

.hover\\:bg\\(brand-dark\\):hover {
  background-color: var(--croff-color-brand-dark);
}

.focus\\:ring\\(2\\):focus {
  box-shadow: 0 0 0 2px currentColor;
}

.disabled\\:opacity\\(50\\):disabled {
  opacity: 0.5;
}

@media (min-width: 768px) {
  .md\\:width\\(1\\/2\\) {
    width: 50%;
  }
}

@media (min-width: 1024px) {
  .lg\\:width\\(1\\/3\\) {
    width: 33.333333%;
  }
}
"
`;
