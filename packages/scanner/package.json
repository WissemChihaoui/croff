  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  },
  "keywords": [
    "css",
    "croff",
    "scanner"
  ]
